# ── Line endings ─────────────────────────────────────────────────────────
# Shell scripts (.sh/.command) break on macOS/Linux if a Windows editor ever
# writes them with CRLF — bash chokes on the trailing \r. Batch files, the
# reverse: cmd.exe is happiest with CRLF. Enforce both so anyone can edit on
# any platform without breaking the other two.

* text=auto

# POSIX sources: always LF (bash / python / web / docs / configs)
*.py     text eol=lf
*.sh     text eol=lf
*.command text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.ps1    text eol=lf
*.ini    text eol=lf

# Windows batch: CRLF (safest for cmd.exe label/goto parsing)
*.bat    text eol=crlf
*.cmd    text eol=crlf

# ── Binaries (never touch) ───────────────────────────────────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
*.tgz    binary
*.dmg    binary
*.apk    binary
*.apkm   binary
*.db     binary
*.sqlite binary
